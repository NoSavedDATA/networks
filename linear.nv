class Linear
	int m, n
	gpu_tensor w
	ctor(int m, int n, str init)
		self.m = m
		self.n = n
		self.w = new gpu_tensor([n,m], init)
		self.w.as_weight()
	def gpu_tensor forward(gpu_tensor x)
		if x.dims[-1]!=self.m
			print("Error: Linear expected input dim: ", self.m)
			print("Got")
			x.print_dims()
			_quit_()
		return x@self.w
